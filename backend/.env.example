# Server
PORT=4000
NODE_ENV=production

# Comma-separated list of origins allowed to call this API
# e.g. https://your-admin-panel.onrender.com,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ---- Firebase Admin SDK credentials ----
# Get these from Firebase Console > Project Settings > Service Accounts > Generate new private key
# Paste the values from the downloaded JSON file here (keep the quotes around the private key).
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Note: this project does NOT use Firebase Storage. Car photos are
# compressed on the mobile app and stored as base64 strings directly in
# Firestore, so there's no storage bucket to configure.
