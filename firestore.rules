rules_version = '2';

// All Firestore reads/writes for this app go through the backend API,
// which uses the Firebase Admin SDK and therefore bypasses these rules
// entirely. We deny all direct client access as defense in depth, so a
// stolen client config can never be used to read or write data straight
// from a browser or app.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
